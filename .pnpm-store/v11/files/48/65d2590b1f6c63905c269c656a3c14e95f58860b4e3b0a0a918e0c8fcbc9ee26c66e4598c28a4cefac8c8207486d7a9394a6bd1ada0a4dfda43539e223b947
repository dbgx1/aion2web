are\n    // independent — see start()/stop() docs).\n    reject?.(error)\n    this.notifyError(error)\n  }\n\n  /** Invoke the user onError callback, isolating a throw so it can't disrupt\n   * internal state teardown or strand a pending promise. */\n  private notifyError(error: Error): void {\n    try {\n      this.options.onError?.(error)\n    } catch {\n      // A user onError that throws must not propagate into recorder internals.\n    }\n  }\n\n  private releaseStream(): void {\n    this.stream?.getTracks().forEach((t) => t.stop())\n    this.stream = null\n  }\n\n  /** Detach all event handlers so a stale recorder can't mutate our state. */\n  private detachRecorder(): void {\n    const recorder = this.recorder\n    if (!recorder) {\n      return\n    }\n    recorder.onstop = null\n    recorder.onerror = null\n    recorder.ondataavailable = null\n  }\n}\n"],"mappings":";;;;;;;AA0DA,IAAa,gBAAb,MAA2B;CACzB;CACA,WAAyC;CACzC,SAAqC;CACrC,SAA8B,CAAC;CAC/B,YAAoB;CACpB,SAAqC;CAErC,WAAmB;CAGnB,gBAAwB;CACxB,4BAA6B,IAAI,IAAyC;CAC1E,cAAoE;CACpE,aAAsD;CAEtD,YAAY,UAAgC,CAAC,GAAG;EAC9C,KAAK,UAAU;CACjB;;CAGA,OAAO,cAAuB;EAC5B,OACE,OAAO,cAAc,eACrB,OAAO,UAAU,iBAAiB,eAClC,OAAO,UAAU,aAAa,iBAAiB,cAC/C,OAAO,kBAAkB;CAE7B;CAEA,IAAI,QAA4B;EAC9B,OAAO,KAAK;CACd;CAEA,UAAU,IAAqD;EAC7D,KAAK,UAAU,IAAI,EAAE;EACrB,aAAa;GACX,KAAK,UAAU,OAAO,EAAE;EAC1B;CACF;CAEA,SAAiB,OAAiC;EAChD,KAAK,SAAS;EACd,KAAK,MAAM,MAAM,KAAK,WACpB,GAAG,KAAK;CAEZ;CAEA,MAAM,QAAuB;EAC3B,IAAI,KAAK,WAAW,UAAU,KAAK,UACjC;EAEF,KAAK,WAAW;EAChB,IAAI;GACF,MAAM,SAAS,MAAM,UAAU,aAAa,aAAa,EACvD,OAAO,KAAK,QAAQ,SAAS,KAC/B,CAAC;GAID,IAAI,KAAK,eAAe;IACtB,OAAO,UAAU,CAAC,CAAC,SAAS,MAAM,EAAE,KAAK,CAAC;IAC1C;GACF;GACA,KAAK,SAAS;GACd,MAAM,SAAS,KAAK,QAAQ;GAC5B,MAAM,cACJ,UACA,OAAO,cAAc,oBAAoB,cACzC,cAAc,gBAAgB,MAAM,IAChC,SACA,KAAA;GACN,MAAM,WAAW,cACb,IAAI,cAAc,QAAQ,EAAE,UAAU,YAAY,CAAC,IACnD,IAAI,cAAc,MAAM;GAC5B,KAAK,SAAS,CAAC;GACf,SAAS,mBAAmB,MAAM;IAChC,IAAI,EAAE,KAAK,OAAO,GAChB,KAAK,OAAO,KAAK,EAAE,IAAI;GAE3B;GACA,SAAS,eAAe;IACtB,KAAU,SAAS;GACrB;GACA